{
  "name": "pawgauge",
  "version": "0.4.41",
  "description": "Tray and menu-bar widget that shows AI plan usage and remaining quota, with ShadowBlack keeping watch",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilibalashadowpaw/PawGauge.git"
  },
  "keywords": [
    "ai",
    "usage",
    "quota",
    "tray",
    "menu-bar",
    "electron",
    "claude",
    "deepseek",
    "z.ai",
    "minimax"
  ],
  "author": "Bilibala Shadowpaw Limited",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bilibalashadowpaw/PawGauge/issues"
  },
  "homepage": "https://github.com/bilibalashadowpaw/PawGauge#readme",
  "private": true,
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "build": {
    "appId": "com.bilishadowpaw.pawgauge",
    "productName": "PawGauge",
    "copyright": "ShadowBlack (c) Bilibala Shadowpaw Limited",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "ART-LICENSE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PawGauge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "PawGauge ${version}"
    }
  }
}
